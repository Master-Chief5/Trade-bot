# Build-time settings for the hosted app.
#
# Both values are public by design. The publishable key ships inside the bundle of
# every Supabase app; it grants nothing on its own, because the database refuses
# every row that does not belong to the signed-in user, and every dorm record is
# encrypted on the device before it is sent. It cannot read a boy's name.
#
# A dean taking over hosting should replace these with their own project's values.
VITE_SUPABASE_URL=https://zkreblgdshojdxfhnzck.supabase.co
VITE_SUPABASE_KEY=sb_publishable_5jybJhdKtLFPIUYw8RFkCw_ZteKpTnc
