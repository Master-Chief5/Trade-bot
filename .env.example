# Online sync (optional). Without these the app runs on one device only.
#
# The publishable key is meant to be public: it ships inside the app bundle, and
# it grants nothing on its own. The database refuses every row that does not
# belong to the signed-in user, and every dorm record is encrypted on the device
# before it is sent, so the key cannot read a boy's name.
#
# Copy this file to .env, or set these in your host's environment settings.
VITE_SUPABASE_URL=https://zkreblgdshojdxfhnzck.supabase.co
VITE_SUPABASE_KEY=sb_publishable_5jybJhdKtLFPIUYw8RFkCw_ZteKpTnc
